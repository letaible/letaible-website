---
import "../styles/global.css";
const { title, description, lang = "de", altUrl } = Astro.props;
const desc =
  description ??
  (lang === "en"
    ? "letaible is a software studio for cloud security and compliance. We build tools that live up to their claims."
    : "letaible ist ein Software-Studio für Cloud-Sicherheit und Compliance. Wir bauen Werkzeuge, die halten, was sie behaupten.");
const year = new Date().getFullYear();
const resolvedAltUrl = altUrl ?? (lang === "de" ? "/en/" : "/");
const home = lang === "en" ? "/en/" : "/";
const kontaktHref = lang === "en" ? "/en/contact/" : "/kontakt/";

const t =
  lang === "en"
    ? {
        brandAria: "letaible homepage",
        navProdukte: "Products",
        navKontakt: "Contact",
        footKontakt: "Contact",
        footImpressum: "Imprint (German)",
        footDatenschutz: "Privacy (German)",
      }
    : {
        brandAria: "letaible Startseite",
        navProdukte: "Produkte",
        navKontakt: "Kontakt",
        footKontakt: "Kontakt",
        footImpressum: "Impressum",
        footDatenschutz: "Datenschutz",
      };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Strato-Webspace verarbeitet keine .htaccess, daher Client-Redirect auf
      // HTTPS. Vorher ein Probe-Fetch: nur umleiten, wenn TLS wirklich
      // funktioniert (sonst bliebe die Seite bei fehlendem Zertifikat haengen).
      if (location.protocol === "http:" && location.hostname !== "localhost") {
        fetch("https://" + location.host + "/favicon.svg", { mode: "no-cors", cache: "no-store" })
          .then(function () {
            location.replace("https://" + location.host + location.pathname + location.search + location.hash);
          })
          .catch(function () {});
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content="https://letaible.de/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="site-head">
      <div class="container head-inner">
        <a href={home} class="brand" aria-label={t.brandAria}>
          <svg class="brand-logo" viewBox="0 0 64 64" width="26" height="26" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="#0b1b34"></rect>
            <text x="29" y="45" font-family="Segoe UI, Arial, sans-serif" font-size="36" font-weight="700" fill="#ffffff" text-anchor="middle">l</text>
            <circle cx="41" cy="42" r="4.5" fill="#f59e0b"></circle>
          </svg>
          <span>letaible</span>
        </a>
        <nav class="nav">
          <a href={`${home}#produkte`}>{t.navProdukte}</a>
          <a href={`${home}#kontakt`}>{t.navKontakt}</a>
          <a class="lang-switch" href={resolvedAltUrl}>{lang === "de" ? "EN" : "DE"}</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-foot foot-dark">
      <div class="container foot-inner">
        <span class="foot-brand">letaible</span>
        <nav class="foot-links">
          <a href="https://nis2scan.de" rel="noopener">nis2scan</a>
          <a href={kontaktHref}>{t.footKontakt}</a>
          <a href="/impressum/">{t.footImpressum}</a>
          <a href="/datenschutz/">{t.footDatenschutz}</a>
        </nav>
      </div>
      <div class="container foot-copy">© {year} Letaible GmbH</div>
    </footer>

    <style>
      .site-head { position: sticky; top: 0; z-index: 10; background: rgba(255,255,255,.85); backdrop-filter: saturate(1.6) blur(8px); border-bottom: 1px solid var(--border); }
      .head-inner { display: flex; align-items: center; justify-content: space-between; height: 64px; }
      .brand { display: flex; align-items: center; gap: 0.5rem; font-weight: 800; color: var(--navy-900); font-size: 1.25rem; letter-spacing: -0.02em; text-decoration: none; }
      .brand-logo { border-radius: 6px; flex-shrink: 0; }
      .nav { display: flex; align-items: center; gap: 1.25rem; }
      .nav a { text-decoration: none; color: var(--slate); font-weight: 500; font-size: 0.95rem; }
      .nav a:hover { color: var(--navy-800); }
      .nav a.lang-switch { border: 1px solid var(--border); border-radius: 8px; padding: 0.25rem 0.55rem; }
      .site-foot { border-top: 1px solid var(--border); background: var(--paper); margin-top: 4rem; padding: 2rem 0 1.5rem; }
      .foot-inner { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
      .foot-brand { font-weight: 800; color: var(--navy-900); }
      .foot-links { display: flex; gap: 1.25rem; }
      .foot-links a { color: var(--slate); text-decoration: none; font-size: 0.92rem; }
      .foot-links a:hover { color: var(--navy-800); }
      .foot-copy { margin-top: 1.25rem; color: var(--slate-300); font-size: 0.85rem; }
    </style>
  </body>
</html>
