---
import Base from "../layouts/Base.astro";

const principles = [
  ["Ehrlich statt laut", "Unsere Werkzeuge behaupten nie mehr, als sie geprüft haben. Was nicht sicher feststeht, wird als offen markiert — nicht beschönigt."],
  ["Rechtssicher gebaut", "Compliance ist kein Marketing-Etikett. Wo wir auf Gesetze verweisen, ist die Quelle belegt und nachprüfbar."],
  ["Offen, wo es geht", "Kernfunktionen sind quelloffen. Transparenz schafft Vertrauen — gerade in der Sicherheit."],
];
---

<Base title="letaible — Studio für sichere, rechtskonforme Cloud-Software">
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Software-Studio</p>
      <h1>Werkzeuge, die halten, was sie behaupten.</h1>
      <p class="lede">
        letaible baut Software für Cloud-Sicherheit und Compliance — mit einem
        Grundsatz: Ehrlichkeit vor Effekt. Wir sagen, was ein Werkzeug prüft,
        und ebenso klar, was es nicht kann.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#produkte">Unsere Produkte</a>
        <a class="btn btn-ghost" href="#kontakt">Kontakt</a>
      </div>
    </div>
  </section>

  <section class="section band" id="produkte">
    <div class="container">
      <p class="eyebrow">Produkte</p>
      <h2>Woran wir arbeiten.</h2>
      <div class="product">
        <div class="product-mark">§30</div>
        <div>
          <h3>nis2scan</h3>
          <p>
            Open-Source-Scanner für §30 BSIG (NIS2): prüft AWS &amp; Azure gegen
            die zehn Pflichtmaßnahmen — jeder Befund mit Rechtsgrundlage und
            ISO-27001-Bezug. Kostenlos und quelloffen; eine Professional- und
            eine SaaS-Variante ergänzen den freien Kern.
          </p>
          <a class="btn btn-ghost btn-sm" href="https://nis2scan.de" rel="noopener">Zu nis2scan →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Haltung</p>
      <h2>Wofür wir stehen.</h2>
      <div class="grid cols-3" style="margin-top:1.75rem">
        {principles.map(([t, d]) => (
          <div class="card">
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section band" id="kontakt">
    <div class="container cta">
      <h2>Sprechen wir.</h2>
      <p class="lede" style="margin:0 auto 1.25rem">
        Fragen zu unseren Produkten, Kooperation oder Pilotprojekten?
      </p>
      <p><a class="btn btn-primary" href="mailto:[KONTAKT-E-MAIL]">[KONTAKT-E-MAIL]</a></p>
      <p class="hint">Platzhalter — vor Livegang durch die echte Kontaktadresse ersetzen.</p>
    </div>
  </section>

  <style>
    .hero { padding: clamp(3.5rem, 9vw, 6rem) 0 clamp(2rem, 5vw, 3rem); }
    .hero-inner { max-width: 760px; }
    .hero h1 { margin: 0 0 1.1rem; }
    .hero-cta { display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.75rem; }
    .band { background: var(--paper); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .product { display: flex; gap: 1.5rem; align-items: flex-start; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 1.75rem; margin-top: 1.5rem; max-width: 760px; }
    .product-mark { background: var(--navy-800); color: #fff; font-weight: 700; border-radius: 10px; padding: 0.5rem 0.7rem; font-size: 1.1rem; white-space: nowrap; }
    .product h3 { margin: 0 0 0.5rem; }
    .product p { margin: 0 0 1rem; }
    .btn-sm { padding: 0.5rem 0.9rem; font-size: 0.9rem; }
    .cta { text-align: center; max-width: 560px; margin: 0 auto; }
    .hint { color: var(--slate); font-size: 0.85rem; margin-top: 0.5rem; }
  </style>
</Base>
