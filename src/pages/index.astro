---
import Base from "../layouts/Base.astro";

const principles = [
  ["01", "Ehrlich statt laut", "Unsere Werkzeuge behaupten nie mehr, als sie geprüft haben. Was nicht sicher feststeht, wird als offen markiert statt beschönigt."],
  ["02", "Rechtssicher gebaut", "Compliance ist kein Marketing-Etikett. Wo wir auf Gesetze verweisen, ist die Quelle belegt und im Vier-Augen-Review nachgeprüft."],
  ["03", "Offen, wo es geht", "Kernfunktionen sind quelloffen. Transparenz schafft Vertrauen, gerade in der Sicherheit."],
];
---

<Base title="letaible · Software für Cloud-Sicherheit und Compliance" altUrl="/en/">
  <section class="hero-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Software-Studio · Fürth</p>
      <h1>Werkzeuge, die halten,<br />was sie behaupten.</h1>
      <p class="lede">
        Die Letaible GmbH baut Software für Cloud-Sicherheit und Compliance.
        Unser Grundsatz: Ehrlichkeit vor Effekt. Wir sagen, was ein
        Werkzeug prüft, und ebenso klar, was es nicht kann.
      </p>
      <div class="hero-cta">
        <a class="btn btn-amber" href="#produkte">Unsere Produkte</a>
        <a class="btn btn-outline-light" href="/kontakt/">Kontakt</a>
      </div>
    </div>
    <div class="container">
      <div class="trust-strip">
        <span class="t">Deutsche Rechtstiefe</span>
        <span class="t">Open-Core-Modell</span>
        <span class="t">Read-only by design</span>
        <span class="t">EU-Datenhaltung</span>
      </div>
    </div>
  </section>

  <section class="section" id="produkte">
    <div class="container">
      <p class="eyebrow">Produkte</p>
      <h2 class="h-underline">Woran wir arbeiten.</h2>
      <div class="product">
        <div class="product-visual">
          <div class="codeblock" style="font-size:0.85rem">
            <span class="g">$</span> pip install nis2scan<br />
            <span class="g">$</span> nis2scan scan --provider aws<br /><br />
            <span class="c">Nr. 8 Kryptographie … erfüllt ✓</span>
          </div>
        </div>
        <div>
          <h3>nis2scan</h3>
          <p>
            Open-Source-Scanner für §30 BSIG (NIS2): prüft AWS &amp; Azure gegen
            die zehn Pflichtmaßnahmen, jeder Befund mit wörtlichem
            Gesetzeszitat und ISO-27001-Bezug. Der freie Kern ist vollständig
            nutzbar; Professional- und Enterprise-Stufen ergänzen Komfort und
            Skalierung, nie Korrektheit.
          </p>
          <a class="btn btn-primary btn-sm" href="https://nis2scan.de" rel="noopener">Zu nis2scan →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="beratung">
    <div class="container">
      <p class="eyebrow">Beratung</p>
      <h2 class="h-underline">Cloud Security, hands-on.</h2>
      <p class="beratung-lede">
        Neben unseren Werkzeugen unterstützen wir Unternehmen direkt: mit
        klarem Blick auf ihre Cloud-Umgebungen und mit Maßnahmen, die sich
        auch umsetzen lassen. Keine Gutachten fürs Regal.
      </p>
      <div class="grid cols-3" style="margin-top:2rem">
        <div class="card">
          <div class="pnum">01</div>
          <h3>NIS2-Readiness-Check</h3>
          <p>
            Standortbestimmung gegen die zehn Pflichtmaßnahmen des §30 BSIG:
            was schon trägt, was fehlt und was zuerst drankommt. Verständlich
            für Geschäftsführung und Technik.
          </p>
        </div>
        <div class="card">
          <div class="pnum">02</div>
          <h3>Cloud-Security-Review</h3>
          <p>
            Architektur- und Konfigurationsprüfung für AWS, Azure und Google
            Cloud, von Identitäten über Netzwerk bis Verschlüsselung. Jeder
            Befund mit einem konkreten Härtungsschritt.
          </p>
        </div>
        <div class="card">
          <div class="pnum">03</div>
          <h3>Security Engineering auf Zeit</h3>
          <p>
            Umsetzung statt Papier: Absicherung von CI/CD, Berechtigungen und
            Workloads, gemeinsam mit Ihrem Team und mit sauberer Übergabe.
          </p>
        </div>
      </div>
      <p class="beratung-note">
        Beratung und Werkzeug greifen bei uns ineinander: Was sich
        automatisiert prüfen lässt, prüfen wir automatisiert. So bleibt der
        erreichte Stand auch nach dem Einsatz messbar.
      </p>
      <a class="btn btn-primary" href="/kontakt/">Erstgespräch anfragen</a>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <p class="eyebrow">Haltung</p>
      <h2 class="h-underline">Wofür wir stehen.</h2>
      <div class="grid cols-3" style="margin-top:2rem">
        {principles.map(([nr, t, d]) => (
          <div class="card">
            <div class="pnum">{nr}</div>
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hero-dark cta-dark" id="kontakt">
    <div class="container cta">
      <h2 style="color:#fff">Sprechen wir.</h2>
      <p class="lede" style="margin:0 auto 1.5rem">
        Fragen zu unseren Produkten, Kooperationen oder Pilotprojekte?
      </p>
      <div class="hero-cta" style="justify-content:center">
        <a class="btn btn-amber" href="/kontakt/">Kontakt aufnehmen</a>
        <a class="btn btn-outline-light" href="mailto:info@letaible.de">info@letaible.de</a>
      </div>
    </div>
  </section>

  <style>
    .hero-dark { padding: clamp(3.5rem, 9vw, 6rem) 0 0; }
    .hero-inner { max-width: 780px; padding-bottom: clamp(2rem, 5vw, 3rem); }
    .hero-inner h1 { margin: 0 0 1.1rem; }
    .hero-cta { display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.75rem; }
    .trust-strip .t::before { content: "·"; color: var(--accent); margin-right: 0.45rem; }
    .band { background: var(--paper); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .product { display: grid; grid-template-columns: 1fr 1.3fr; gap: 2rem; align-items: center; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 2rem; margin-top: 1.75rem; box-shadow: 0 12px 34px rgba(15,23,42,.07); }
    @media (max-width: 820px) { .product { grid-template-columns: 1fr; } }
    .product h3 { margin: 0 0 0.5rem; font-size: 1.35rem; }
    .product p { margin: 0 0 1.1rem; }
    .btn-sm { padding: 0.55rem 1rem; font-size: 0.92rem; }
    .pnum { font-family: var(--mono); font-weight: 700; color: var(--accent-600); font-size: 0.95rem; margin-bottom: 0.5rem; }
    .cta-dark { padding: clamp(3rem, 7vw, 4.5rem) 0; margin-top: 0; }
    .cta { text-align: center; max-width: 560px; margin: 0 auto; }
    .beratung-lede { max-width: 640px; margin: 1rem 0 0; }
    .beratung-note { max-width: 640px; margin: 1.75rem 0 1.25rem; }
  </style>
</Base>
