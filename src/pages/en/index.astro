---
import Base from "../../layouts/Base.astro";

const principles = [
  ["01", "Honest, not loud", "Our tools never claim more than they have actually verified. Whatever is not certain gets flagged as open, not glossed over."],
  ["02", "Built on solid legal ground", "Compliance is not a marketing label. Wherever we reference a law, the source is documented and verified in a four-eyes review."],
  ["03", "Open wherever possible", "Core features are open source. Transparency builds trust, especially in security."],
];
---

<Base title="letaible · Software for cloud security and compliance" lang="en" altUrl="/">
  <section class="hero-dark">
    <div class="container hero-inner">
      <p class="eyebrow">Software studio · Fürth</p>
      <h1>Tools that live up<br />to their claims.</h1>
      <p class="lede">
        Letaible GmbH builds software for cloud security and compliance.
        Our principle: honesty over effect. We state clearly what a tool
        checks, and just as clearly what it cannot do.
      </p>
      <div class="hero-cta">
        <a class="btn btn-amber" href="#produkte">Our products</a>
        <a class="btn btn-outline-light" href="/en/contact/">Contact</a>
      </div>
    </div>
    <div class="container">
      <div class="trust-strip">
        <span class="t">German legal depth</span>
        <span class="t">Open-core model</span>
        <span class="t">Read-only by design</span>
        <span class="t">EU data hosting</span>
      </div>
    </div>
  </section>

  <section class="section" id="produkte">
    <div class="container">
      <p class="eyebrow">Products</p>
      <h2 class="h-underline">What we are building.</h2>
      <div class="product">
        <div class="product-visual">
          <div class="codeblock" style="font-size:0.85rem">
            <span class="g">$</span> pip install nis2scan<br />
            <span class="g">$</span> nis2scan scan --provider aws<br /><br />
            <span class="c">No. 8 Cryptography … fulfilled ✓</span>
          </div>
        </div>
        <div>
          <h3>nis2scan</h3>
          <p>
            Open-source scanner for §30 BSIG (the German NIS2 implementation
            in the BSI Act): checks AWS &amp; Azure against the ten
            mandatory measures, every finding with a verbatim statutory
            citation and its ISO 27001 reference. The free core is fully
            usable on its own; the Professional and Enterprise tiers add
            convenience and scale, never correctness.
          </p>
          <a class="btn btn-primary btn-sm" href="https://nis2scan.de" rel="noopener">Go to nis2scan →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <p class="eyebrow">Our stance</p>
      <h2 class="h-underline">What we stand for.</h2>
      <div class="grid cols-3" style="margin-top:2rem">
        {principles.map(([nr, t, d]) => (
          <div class="card">
            <div class="pnum">{nr}</div>
            <h3>{t}</h3>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hero-dark cta-dark" id="kontakt">
    <div class="container cta">
      <h2 style="color:#fff">Let's talk.</h2>
      <p class="lede" style="margin:0 auto 1.5rem">
        Questions about our products, partnerships, or pilot projects?
      </p>
      <div class="hero-cta" style="justify-content:center">
        <a class="btn btn-amber" href="/en/contact/">Go to the contact form</a>
        <a class="btn btn-outline-light" href="mailto:info@letaible.de">info@letaible.de</a>
      </div>
    </div>
  </section>

  <style>
    .hero-dark { padding: clamp(3.5rem, 9vw, 6rem) 0 0; }
    .hero-inner { max-width: 780px; padding-bottom: clamp(2rem, 5vw, 3rem); }
    .hero-inner h1 { margin: 0 0 1.1rem; }
    .hero-cta { display: flex; gap: 0.85rem; flex-wrap: wrap; margin-top: 1.75rem; }
    .trust-strip .t::before { content: "·"; color: var(--accent); margin-right: 0.45rem; }
    .band { background: var(--paper); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
    .product { display: grid; grid-template-columns: 1fr 1.3fr; gap: 2rem; align-items: center; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 2rem; margin-top: 1.75rem; box-shadow: 0 12px 34px rgba(15,23,42,.07); }
    @media (max-width: 820px) { .product { grid-template-columns: 1fr; } }
    .product h3 { margin: 0 0 0.5rem; font-size: 1.35rem; }
    .product p { margin: 0 0 1.1rem; }
    .btn-sm { padding: 0.55rem 1rem; font-size: 0.92rem; }
    .pnum { font-family: var(--mono); font-weight: 700; color: var(--accent-600); font-size: 0.95rem; margin-bottom: 0.5rem; }
    .cta-dark { padding: clamp(3rem, 7vw, 4.5rem) 0; margin-top: 0; }
    .cta { text-align: center; max-width: 560px; margin: 0 auto; }
  </style>
</Base>
